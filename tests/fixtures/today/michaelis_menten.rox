-- fixture: michaelis_menten
-- role: conservation
-- status: runnable today
-- oracle: Euler steps of the enzyme reaction S -> P with rate vmax*S/(km+S).
--         substrate + product == 10 on every row. Rate saturates near vmax when S >> km.
-- compare: float tolerance 1e-9 relative

param vmax: float = 1
param km: float = 2
param dt: float = 0.1

state Reaction { substrate: float, product: float }

step React:
    input:
        rate: float = vmax * s.substrate / (km + s.substrate)
    mechanism:
        substrate: s.substrate - u.rate * dt
        product: s.product + u.rate * dt

system Enzyme: Reaction = React

run Enzyme from Reaction { substrate: 10, product: 0 } for 100 steps
    sweep km in [0.5, 2, 8]
