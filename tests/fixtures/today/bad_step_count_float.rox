-- fixture: bad_step_count_float
-- role: negative
-- status: runnable today
-- oracle: the step count must be an int, not a float.
-- compare: exact (error text)

state Counter { n: int }

step Tick:
    mechanism:
        n: s.n + 1

system Clock: Counter = Tick

run Clock from Counter { n: 0 } for 2.5 steps
