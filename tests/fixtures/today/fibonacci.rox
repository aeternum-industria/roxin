-- fixture: fibonacci
-- role: golden
-- status: runnable today
-- oracle: after k steps from (0, 1), `a` is F(k). Row 100: a = 354224848179261915075.
--         Both fields read the OLD state, so this only works if updates are simultaneous.
-- compare: exact

state Fib { a: int, b: int }

step Next:
    mechanism:
        a: s.b
        b: s.a + s.b

system Fibonacci: Fib = Next

run Fibonacci from Fib { a: 0, b: 1 } for 100 steps
