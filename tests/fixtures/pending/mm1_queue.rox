-- fixture: mm1_queue
-- role: golden (statistical)
-- status: pending: `uniform`, `runs`, `seed`, `max`
-- oracle: discrete-time queue: arrival with probability 0.3, service with probability 0.5.
--         The queue length is a birth-death chain with up-rate p(1-q) = 0.15 and down-rate
--         q(1-p) = 0.35, so the stationary mean is rho/(1-rho) with rho = 0.15/0.35: 0.75.
--         Average the last 1000 of 5000 steps over 200 runs; expect 0.75 +- 0.1.
-- compare: statistical

param p: float = 0.3
param q: float = 0.5

state Queue { length: int }

step Tick:
    input:
        arrive: int = if uniform(0, 1) < p then 1 else 0
        serve: int = if uniform(0, 1) < q then 1 else 0
    mechanism:
        length: max(s.length + u.arrive - u.serve, 0)

system Line: Queue = Tick

run Line from Queue { length: 0 } for 5000 steps
    runs 200
    seed 11
