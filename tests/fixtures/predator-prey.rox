param birth: float = 0.1
param hunt: float = 0.002
param conv: float = 0.5
param death: float = 0.1

state Pop { prey: float, pred: float }

step Ecosystem:
    input:
        kills: float = hunt * s.prey * s.pred
    mechanism:
        prey: s.prey + birth * s.prey - u.kills
        pred: s.pred + conv * u.kills * s.pred

system PredatorPrey: Pop = Ecosystem
run PredatorPrey from Pop { prey: 40, pred: 9 } for 2 steps
