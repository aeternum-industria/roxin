param target_temp: float = 20
param k: float = 0.5

state Room { temp: float }

step Heating:
    input:
        heat: float = k * (target_temp - s.temp)
    mechanism:
        temp: s.temp + u.heat

system Thermostat: Room = Heating

run Thermostat from Room { temp: 10 } for 8 steps
    sweep k in [ 0.25, 0.5, 1.5 ]
