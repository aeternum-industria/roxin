{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Roxin",
  "scopeName": "source.roxin",
  "fileTypes": ["rox"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declaration-names" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#spread" },
    { "include": "#state-and-input" },
    { "include": "#properties" },
    { "include": "#capitalized-names" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-dash.roxin", "match": "--.*$" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.roxin",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.roxin", "match": "\\\\." }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.percent.roxin",
          "match": "\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?%(?![\\w(])"
        },
        {
          "name": "constant.numeric.roxin",
          "match": "\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "declaration-names": {
      "patterns": [
        {
          "match": "\\b(state|type|step|system)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.declaration.roxin" },
            "2": { "name": "entity.name.type.roxin" }
          }
        },
        {
          "match": "\\b(invariant|metric|extern)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.declaration.roxin" },
            "2": { "name": "entity.name.function.roxin" }
          }
        },
        {
          "match": "\\b(param|data)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.declaration.roxin" },
            "2": { "name": "variable.other.constant.roxin" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.declaration.roxin",
          "match": "\\b(?:input\\s+map|record\\s+substeps|keep\\s+running)\\b"
        },
        {
          "name": "keyword.other.section.roxin",
          "match": "\\b(?:input|allowed|mechanism)\\b(?=\\s*:)"
        },
        {
          "name": "variable.language.roxin",
          "match": "\\bstep\\b"
        },
        {
          "name": "keyword.other.declaration.roxin",
          "match": "\\b(?:state|type|system|invariant|metric|param|data|tolerance|extern)\\b"
        },
        {
          "name": "keyword.other.run.roxin",
          "match": "\\b(?:run|from|for|steps|sweep|until|every)\\b"
        },
        {
          "name": "keyword.control.roxin",
          "match": "\\b(?:if|then|else|with|within|in)\\b"
        },
        {
          "name": "keyword.operator.logical.roxin",
          "match": "\\b(?:and|or|not)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.roxin",
          "match": "\\b(?:int|float|decimal|bool|text)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.roxin",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.rounding.roxin",
          "match": "\\b(?:down|up|nearest)\\b"
        }
      ]
    },
    "builtins": {
      "name": "support.function.builtin.roxin",
      "match": "\\b(?:sign|abs|min|max|round|sqrt|to_float|sample)\\b(?=\\s*\\()"
    },
    "spread": {
      "match": "(\\.\\.)(s)\\b",
      "captures": {
        "1": { "name": "keyword.operator.spread.roxin" },
        "2": { "name": "variable.language.roxin" }
      }
    },
    "state-and-input": {
      "name": "variable.language.roxin",
      "match": "\\b[su]\\b(?=\\.[A-Za-z_]|\\s+with\\b)"
    },
    "properties": {
      "name": "variable.other.property.roxin",
      "match": "(?<=[A-Za-z0-9_)\\]]\\.)[A-Za-z_][A-Za-z0-9_]*"
    },
    "capitalized-names": {
      "name": "entity.name.type.roxin",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.compose.roxin", "match": ">>" },
        { "name": "keyword.operator.arrow.roxin", "match": "->" },
        { "name": "keyword.operator.range.roxin", "match": "\\.\\." },
        { "name": "keyword.operator.comparison.roxin", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.arithmetic.roxin", "match": "//|\\+|-|\\*|%|\\^" },
        { "name": "keyword.operator.assignment.roxin", "match": "=" }
      ]
    }
  }
}
